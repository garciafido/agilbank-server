enum AbStatementStatus {
  queued
  processing
  read
  failed
}

enum AbCorrectionReview {
  pending
  confirmed
  rejected
}

enum Language {
  es
  en
  pt
}

enum TenantIvaCondition {
  registeredResponsible
  monotax
  exempt
}

enum TenantStatus {
  active
  suspended
}

enum IntegrationClientStatus {
  active
  revoked
}

enum IdempotencyStatus {
  in_progress
  done
  failed
}

enum NotificationType {
  mention
  assignment
  comment
  alert
  system
}

enum NotificationPriority {
  high
  medium
  low
}

enum EmailFrequency {
  immediate
  daily_digest
  weekly_digest
}

enum EmailVerificationStatus {
  pending
  verified
  expired
  revoked
}

model RefreshToken {
  id String @id @default(cuid())
  token String @unique @db.Text
  userId String @map("user_id")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  family String @default(cuid())
  browserName String? @map("browser_name")
  browserVersion String? @map("browser_version")
  osName String? @map("os_name")
  deviceType String? @map("device_type")
  ipAddress String? @map("ip_address")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")
  replacedBy String? @map("replaced_by")
  replacedAt DateTime? @map("replaced_at")
  revokedAt DateTime? @map("revoked_at")
  revokedReason String? @map("revoked_reason")


  @@index([userId])
  @@index([family])
  @@index([expiresAt])
  @@index([token], type: Hash)
  @@map("refresh_tokens")
}

model TrustedDevice {
  id String @id @default(cuid())
  tokenHash String @unique @map("token_hash")
  userId String @map("user_id")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  browserName String? @map("browser_name")
  browserVersion String? @map("browser_version")
  osName String? @map("os_name")
  deviceType String? @map("device_type")
  ipAddress String? @map("ip_address")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt DateTime? @map("revoked_at")
  revokedReason String? @map("revoked_reason")


  @@index([userId])
  @@index([expiresAt])
  @@map("trusted_devices")
}

model SystemStatus {
  id String @id @default("system")
  status String
  message String?
  scheduledAt DateTime? @map("scheduled_at")
  startedAt DateTime? @map("started_at")
  estimatedEnd DateTime? @map("estimated_end")
  updatedAt DateTime @updatedAt @map("updated_at")


  @@map("system_status")
}

model AbStatement {
  id                  String     @id @default(uuid())
  version_            String     @map("version__")
  createdAt_          DateTime   @map("created_at__")
  createdBy_          User      @relation("AbStatement_createdBy_", fields: [createdBy_id_], references: [id])
  createdBy_id_       String    @map("created_by__id__")
  lastUpdatedAt_      DateTime?  @map("last_updated_at__")
  lastUpdatedBy_      User?      @relation("AbStatement_lastUpdatedBy_", fields: [lastUpdatedBy_id_], references: [id])
  lastUpdatedBy_id_   String?    @map("last_updated_by__id__")
  tenant_             Tenant     @relation("AbStatement_tenant_", fields: [tenant_id_], references: [id])
  tenant_id_          String    @map("tenant__id__")
  file String  
  file_server_data Json @map("file__server_data")
  file_data Json @map("file__data")
  originalName String @map("original_name")
  contentHash String? @map("content_hash")
  status AbStatementStatus  @default(queued)
  verdict String?
  bankCode String? @map("bank_code")
  cbu String?
  periodFrom DateTime? @db.Date @map("period_from")
  periodTo DateTime? @db.Date @map("period_to")
  openingBalance Decimal? @map("opening_balance")
  closingBalance Decimal? @map("closing_balance")
  lineCount Int? @map("line_count")
  declaredAccount Json? @map("declared_account")
  reading Json?
  error String?
  processedAt DateTime? @map("processed_at")
  readStarts Int  @default(0) @map("read_starts")

  @@unique([tenant_id_, contentHash])
  @@index([tenant_id_, createdAt_])

  @@map(name: "ab_statement")
}

