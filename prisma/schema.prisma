  createdBy_id_       String?    @map("created_by__id__")
  lastUpdatedAt_      DateTime?  @map("last_updated_at__")
  lastUpdatedBy_      User?      @relation("User_lastUpdatedBy_", fields: [lastUpdatedBy_id_], references: [id])
  lastUpdatedBy_id_   String?    @map("last_updated_by__id__")
  tenant_             Tenant     @relation("User_tenant_", fields: [tenant_id_], references: [id])
  tenant_id_          String    @map("tenant__id__")
  tenantDisplayName String? @map("tenant_display_name")
  email String @unique
  name String
  active Boolean
  language Language  @default(es)
  avatar String?  
  avatar_server_data Json? @map("avatar__server_data")
  avatar_data Json? @map("avatar__data")
  cellphone String?
  twoFaseAuth Boolean?  @default(false) @map("two_fase_auth")
  twoFaSecret String? @map("two_fa_secret")
  twoFaBackupCodes String? @map("two_fa_backup_codes")
  twoFaVerifiedAt DateTime? @map("two_fa_verified_at")
  passwordResetToken String? @map("password_reset_token")
  passwordResetExpiresAt DateTime? @map("password_reset_expires_at")
  profile Json?
  roles Role[] @relation("User_roles")
  password String
  welcomeEmailsentAt DateTime? @map("welcome_email_sent_at__")
  passwordResetEmailsentAt DateTime? @map("password_reset_email_sent_at__")
  lastEmailError_ String? @map("last_email_error__")
  refreshTokens RefreshToken[]
  trustedDevices TrustedDevice[]
  AbStatement_createdBy_ AbStatement[] @relation("AbStatement_createdBy_")
  AbStatement_lastUpdatedBy_ AbStatement[]  @relation("AbStatement_lastUpdatedBy_")
  AbConceptCorrection_createdBy_ AbConceptCorrection[] @relation("AbConceptCorrection_createdBy_")
  AbConceptCorrection_lastUpdatedBy_ AbConceptCorrection[]  @relation("AbConceptCorrection_lastUpdatedBy_")
  AbReconciliation_createdBy_ AbReconciliation[] @relation("AbReconciliation_createdBy_")
  AbReconciliation_lastUpdatedBy_ AbReconciliation[]  @relation("AbReconciliation_lastUpdatedBy_")
  AbPaymentBatch_createdBy_ AbPaymentBatch[] @relation("AbPaymentBatch_createdBy_")
  AbPaymentBatch_lastUpdatedBy_ AbPaymentBatch[]  @relation("AbPaymentBatch_lastUpdatedBy_")
  User_createdBy_ User[] @relation("User_createdBy_")
  User_lastUpdatedBy_ User[]  @relation("User_lastUpdatedBy_")
  Role_createdBy_ Role[] @relation("Role_createdBy_")
  Role_lastUpdatedBy_ Role[]  @relation("Role_lastUpdatedBy_")
  Permission_createdBy_ Permission[] @relation("Permission_createdBy_")
  Permission_lastUpdatedBy_ Permission[]  @relation("Permission_lastUpdatedBy_")
  Tenant_createdBy_ Tenant[] @relation("Tenant_createdBy_")
  Tenant_lastUpdatedBy_ Tenant[]  @relation("Tenant_lastUpdatedBy_")
  WorkerEvent_triggerUserId WorkerEvent[] @relation("WorkerEvent_triggerUserId")
  WorkerEvent_createdBy_ WorkerEvent[] @relation("WorkerEvent_createdBy_")
  WorkerEvent_lastUpdatedBy_ WorkerEvent[]  @relation("WorkerEvent_lastUpdatedBy_")
  IntegrationClient_serviceUser IntegrationClient[] @relation("IntegrationClient_serviceUser")
  IntegrationClient_createdBy_ IntegrationClient[] @relation("IntegrationClient_createdBy_")
  IntegrationClient_lastUpdatedBy_ IntegrationClient[]  @relation("IntegrationClient_lastUpdatedBy_")
  IdempotencyRecord_createdBy_ IdempotencyRecord[] @relation("IdempotencyRecord_createdBy_")
  IdempotencyRecord_lastUpdatedBy_ IdempotencyRecord[]  @relation("IdempotencyRecord_lastUpdatedBy_")
  UserNotification_actorUser UserNotification[] @relation("UserNotification_actorUser")
  UserNotification_createdBy_ UserNotification[] @relation("UserNotification_createdBy_")
  UserNotification_lastUpdatedBy_ UserNotification[]  @relation("UserNotification_lastUpdatedBy_")
  UserNotificationPreference_createdBy_ UserNotificationPreference[] @relation("UserNotificationPreference_createdBy_")
  UserNotificationPreference_lastUpdatedBy_ UserNotificationPreference[]  @relation("UserNotificationPreference_lastUpdatedBy_")
  EmailVerification_requestedBy EmailVerification[] @relation("EmailVerification_requestedBy")
  EmailVerification_createdBy_ EmailVerification[] @relation("EmailVerification_createdBy_")
  EmailVerification_lastUpdatedBy_ EmailVerification[]  @relation("EmailVerification_lastUpdatedBy_")

