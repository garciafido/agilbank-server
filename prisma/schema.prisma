  expiresAt DateTime @map("expires_at")
  sentAt DateTime? @map("sent_at")
  verifiedAt DateTime? @map("verified_at")
  sentCount Int  @default(0) @map("sent_count")
  lastSentAt DateTime? @map("last_sent_at")
  requestedBy User @relation("EmailVerification_requestedBy", fields: [requestedBy_id], references: [id])
  requestedBy_id String @map("requested_by__id")
  sourceEntity String? @map("source_entity")
  sourceRecordId String? @map("source_record_id")
  validationChanges Json? @map("validation_changes")
  validationSubmittedAt DateTime? @map("validation_submitted_at")

  @@index([tenant_id_])
  @@index([requestedBy_id])
  @@unique([tenant_id_, email])

  @@map(name: "email_verification")
}
