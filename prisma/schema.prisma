  tenant_             Tenant     @relation("AbConceptCorrection_tenant_", fields: [tenant_id_], references: [id])
  tenant_id_          String    @map("tenant__id__")
  bankCode String? @map("bank_code")
  operationCode String? @map("operation_code")
