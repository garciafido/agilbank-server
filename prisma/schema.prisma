  UserNotificationPreference_tenant_ UserNotificationPreference[]  @relation("UserNotificationPreference_tenant_")
  EmailVerification_tenant_ EmailVerification[]  @relation("EmailVerification_tenant_")

  @@map(name: "tenant")
}

model WorkerEvent {
  id                  String     @id @default(uuid())
  version_            String     @map("version__")
  createdAt_          DateTime   @map("created_at__")
  /// @userScopedForRoles: SiteUser
  createdBy_          User      @relation("WorkerEvent_createdBy_", fields: [createdBy_id_], references: [id])
  createdBy_id_       String    @map("created_by__id__")
  lastUpdatedAt_      DateTime?  @map("last_updated_at__")
  lastUpdatedBy_      User?      @relation("WorkerEvent_lastUpdatedBy_", fields: [lastUpdatedBy_id_], references: [id])
  lastUpdatedBy_id_   String?    @map("last_updated_by__id__")
  tenant_             Tenant     @relation("WorkerEvent_tenant_", fields: [tenant_id_], references: [id])
  tenant_id_          String    @map("tenant__id__")
  queueName String @map("queue_name")
  jobType String @map("job_type")
  status String
  enqueuedAt DateTime @map("enqueued_at")
  startedAt DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  payload Json
  result Json?
  error Json?
  retryCount Int @map("retry_count")
  manualRetryCount Int  @default(0) @map("manual_retry_count")
  nextRetryAt DateTime? @map("next_retry_at")
  duration Int?
  correlationId String? @map("correlation_id")
  triggerUserId User @relation("WorkerEvent_triggerUserId", fields: [triggerUserId_id], references: [id])
  triggerUserId_id String @map("trigger_user_id__id")

  @@index([triggerUserId_id, enqueuedAt])
  @@index([correlationId])
  @@index([jobType, completedAt])
  @@index([queueName, status])
  @@index([tenant_id_, enqueuedAt])

  @@map(name: "worker_event")
}

