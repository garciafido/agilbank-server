datasource db {
  provider   = "postgres"
  // pg_stat_statements y pgaudit las crea el init de postgres-service, no
  // nosotros. Van declaradas igual porque si no, Prisma las ve como DERIVA de la
  // base y exige un reset: le pasó a agilpost recién creado, y le va a pasar a
  // todo proyecto nuevo. Los que ya existen tienen contenedores anteriores a esas
  // líneas del init y por eso no lo notaron.
  extensions = [pgmq, vector, pg_trgm, pg_stat_statements, pgaudit]
}

generator client {
  provider        = "prisma-client"
  previewFeatures = ["fullTextSearchPostgres", "postgresqlExtensions"]
  output          = "../src/prisma/generated-client"
  compilerBuild = "fast" 
}

generator paljs {
  provider = "paljs-generator"
  output   = "../src/paljs-generated"
}

