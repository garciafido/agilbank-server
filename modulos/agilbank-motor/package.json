{
  "name": "@agilbank/motor",
  "version": "0.1.0",
  "private": true,
  "description": "Lee un extracto bancario tal como lo entrega el banco y lo lleva al resumen bancario canónico, con sus controles.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "test": "jest",
