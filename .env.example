# Environment Configuration
# For local development, copy this file to .env and adjust values as needed
# For Docker development, use docker/dev/.env instead

# Node environment
export NODE_ENV=development

# Database connection
# PgBouncer connection pool (for application)
DATABASE_URL=postgresql://postgres:postgres@postgres-service-pgbouncer:6432/agilbank?schema=public&pgbouncer=true

# Direct connection to Postgres, bypassing pgbouncer, for the migration the
# server runs at startup. Set it only when more than one server replica can
# start at once, and only to a value that works from the server container:
# the migration fails closed when it cannot connect.
# MIGRATE_DATABASE_URL=postgresql://postgres:<password>@postgres-service-postgres:5432/agilbank?schema=public

# Database credentials
DB_HOST=postgres-service-postgres
DB_PORT=5432
DB_USER=postgres

# Server configuration
PORT=4030
# El worker es un proceso aparte y expone su propio health: si comparte puerto con
# el server, el que arranque segundo no levanta.
WORKER_HEALTH_PORT=4004
ALLOWED_ORIGIN=http://localhost:3002

# Scaling configuration
SERVER_REPLICAS=1
WORKER_REPLICAS=1
CLIENT_REPLICAS=1

# Pagination limits
MAX_PAGE_SIZE=501
MAX_SKIP_SIZE=2001

# Límite general de /api: pedidos por IP cada 15 minutos (default 100). Una
# integración que manda lotes —una carga inicial, una corrida de evaluación—
# necesita un techo mayor.
# API_RATE_LIMIT_MAX=100

# Almacenamiento de archivos
# filesystem guarda en UPLOAD_DIR. spaces usa un bucket compatible con S3 y pide
# SPACES_ENDPOINT, SPACES_REGION, SPACES_BUCKET, SPACES_ACCESS_KEY y SPACES_SECRET_KEY.
# En los contenedores de producción UPLOAD_DIR lo fija el compose, sobre el volumen
# que comparten server y worker: este valor es para desarrollo local.
STORAGE_PROVIDER=filesystem
UPLOAD_DIR=./public

# Email configuration
# Dev: Mailpit (levantado por dev:up) captura todo el correo saliente.
# UI en http://localhost:8029. Sin auth: nodemailer omite AUTH con SMTP_USER vacío.
# Prod: reemplazar por el SMTP real (host, puerto, credenciales).
SMTP_HOST=localhost
SMTP_PORT=1029
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Agilbank <noreply@agilbank.local>"

# Optional: Application info for email templates
APP_NAME=Agilbank
APP_URL=http://localhost:3002

# JWT configuration
JWT_SECRET=your-secret-key-change-in-production

# Redis configuration
REDIS_URL=redis://redis:6379

# Workers configuration
PGMQ_ENABLED=true
# Polling de colas en ms (default 1000). En desarrollo 5000 alcanza y hace 5x menos queries.
# WORKER_POLL_INTERVAL=5000

# Satellite gRPC Server configuration (optional)
# Enable if you have satellite workers connecting to this server
SATELLITE_ENABLED=false
SATELLITE_GRPC_PORT=50051
SATELLITE_GRPC_HOST=0.0.0.0
# With SATELLITE_ENABLED=true the server also binds the tunnel ports below.
# SATELLITE_TUNNEL_ENABLED=true
# SATELLITE_TUNNEL_PORT=50052
# SATELLITE_TUNNEL_WORKER_PORT=50053

# TLS and client certificates: both default to ENABLED in src/satellite/config.ts.
# They are left commented out on purpose — writing them here as false would make
# this file weaken the server relative to having no .env at all, on a gRPC surface
# between machines. Setting either to false disables authentication of the peer.
# SATELLITE_TLS_ENABLED=false
# SATELLITE_REQUIRE_CLIENT_CERT=false

# Required when TLS is on, which is the default. validateSatelliteConfig refuses
# to start without the three and names the one that is missing.
# SATELLITE_CA_CERT_PATH=./certs/ca.crt
# SATELLITE_SERVER_CERT_PATH=./certs/server.crt
# SATELLITE_SERVER_KEY_PATH=./certs/server.key
